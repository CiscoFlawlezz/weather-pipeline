# ============================================================
# secrets.yaml.example
# ============================================================
# Copy this file to secrets.yaml (repo root) and fill in a real topic.
# secrets.yaml is gitignored -- it must never be committed. The ntfy topic
# is credential-like: anyone who knows it can both post to it and read it,
# since ntfy.sh topics are unauthenticated by default.
#
# If secrets.yaml does not exist, scripts/notify_failure.py no-ops loudly
# (logs a SKIPPED line) rather than failing the calling wrapper.

notify:
  ntfy_topic: "REPLACE_ME_WITH_A_PRIVATE_UNGUESSABLE_TOPIC"
  # Optional; defaults to https://ntfy.sh if omitted.
  # ntfy_server: "https://ntfy.sh"
